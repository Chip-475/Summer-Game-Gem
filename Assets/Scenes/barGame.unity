      m_Calls: []
  m_text: "Solo RUM--> RUM\nSolo Vodka --> Vodka\nRUM e Vodka --> RUM e vodka\nGin
    tonic --> Gin e Tonica\nVodka lemon --> vodka e lemon soda\nRum & cola  --> RUM
    e coca cola\nLong island --> RUM, vodka, gin e coca cola\nRUM sour --> RUM e
    lemon soda\nVodka tonica --> vodka e tonica\nTriple mix --> RUM, vodka e Gin\nJack
    & cola --> Jack daniel's e coca cola\nTennessee Lemon --> Jack daniel's e lemon
    soda\nSmoky Jack --> Jack daniel's e RUM\nJ\xE4ger tonic --> j\xE4germeister
    e tonica\nJ\xE4ger bomb -->J\xE4ger ed energy drink\nHerbal Mix --> j\xE4germeister
    e RUM\nDisaronno sour -->Disaronno e lemon soda\nAmeretto cola --> Disaronno
    e cola\nSweet vodka --> Disaronno e vodka\nTequila Sunrise -->tequila e arancia\nMargarita
    -->Tequila e triple sec\nWhiskey ginger --> whiskey e ginger ale\n"
